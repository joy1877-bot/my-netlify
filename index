<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Joy — UGC Creator · Tech & Products</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700;1,400&family=Syne:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box;}
:root{
  --bg:#050507;
  --bg2:#08080C;
  --surface:#0C0C12;
  --surface2:#101018;
  --white:#F2F0F8;
  --dim:rgba(242,240,248,0.45);
  --faint:rgba(242,240,248,0.08);
  --purple:#8B5CF6;
  --purple-dim:rgba(139,92,246,0.35);
  --purple-faint:rgba(139,92,246,0.08);
  --purple-glow:rgba(139,92,246,0.15);
  --purple-light:#A78BFA;
  --line:rgba(242,240,248,0.07);
  --line-purple:rgba(139,92,246,0.2);
}
html{scroll-behavior:smooth;}
body{background:var(--bg);color:var(--white);font-family:'Syne',sans-serif;font-weight:400;overflow-x:hidden;cursor:none;}

/* CURSOR */
.cur{width:5px;height:5px;background:var(--purple);border-radius:0;position:fixed;top:0;left:0;pointer-events:none;z-index:9999;transform:translate(-50%,-50%);}
.cur-ring{width:26px;height:26px;border:1px solid var(--purple-dim);position:fixed;top:0;left:0;pointer-events:none;z-index:9998;transform:translate(-50%,-50%) rotate(45deg);transition:all .35s cubic-bezier(.25,.46,.45,.94);}

/* SCAN LINES */
body::before{content:'';position:fixed;inset:0;background:repeating-linear-gradient(0deg,transparent,transparent 2px,rgba(242,240,248,0.007) 2px,rgba(242,240,248,0.007) 4px);pointer-events:none;z-index:7000;}

/* NAV */
nav{position:fixed;top:0;left:0;right:0;z-index:500;padding:18px 48px;display:flex;justify-content:space-between;align-items:center;background:rgba(5,5,7,0.94);backdrop-filter:blur(16px);border-bottom:1px solid var(--line);transition:all .4s;}
.nav-mono{font-family:'Space Mono',monospace;font-size:.65rem;color:var(--purple);letter-spacing:.05em;}
.nav-links{display:flex;gap:32px;list-style:none;}
.nav-links a{font-size:.58rem;letter-spacing:.18em;text-transform:uppercase;color:var(--dim);text-decoration:none;transition:color .3s;}
.nav-links a:hover{color:var(--purple-light);}
.nav-avail{display:flex;align-items:center;gap:8px;font-family:'Space Mono',monospace;font-size:.58rem;color:var(--dim);}
.nav-dot{width:5px;height:5px;border-radius:50%;background:#7BC67E;box-shadow:0 0 6px rgba(123,198,126,.5);animation:pulse 2s ease-in-out infinite;}
@keyframes pulse{0%,100%{opacity:1;}50%{opacity:.3;}}

/* HERO */
.hero{min-height:100svh;position:relative;overflow:hidden;display:flex;flex-direction:column;justify-content:flex-end;padding:0 48px 64px;}
.hero-grid-bg{position:absolute;inset:0;background-image:linear-gradient(var(--purple-faint) 1px,transparent 1px),linear-gradient(90deg,var(--purple-faint) 1px,transparent 1px);background-size:56px 56px;}
.hero-glow{position:absolute;top:-10%;left:50%;transform:translateX(-50%);width:100%;height:70%;background:radial-gradient(ellipse 50% 50% at 50% 0%,var(--purple-glow) 0%,transparent 70%);pointer-events:none;}
.hero-corner{position:absolute;font-family:'Space Mono',monospace;font-size:.58rem;color:rgba(139,92,246,0.3);letter-spacing:.08em;line-height:1.8;}
.hero-corner.tl{top:88px;left:48px;}
.hero-corner.tr{top:88px;right:48px;text-align:right;}
.hero-content{position:relative;z-index:2;}
.hero-mono{font-family:'Space Mono',monospace;font-size:.65rem;color:var(--purple);letter-spacing:.06em;margin-bottom:24px;display:flex;align-items:center;gap:10px;}
.hero-mono::before{content:'>';color:var(--purple-light);}
.hero-h1{font-size:clamp(3.5rem,9vw,8rem);font-weight:800;line-height:.9;text-transform:uppercase;letter-spacing:-.03em;margin-bottom:0;}
.h1-solid{display:block;color:var(--white);}
.h1-outline{display:block;color:transparent;-webkit-text-stroke:1px rgba(242,240,248,0.18);}
.h1-purple{display:block;background:linear-gradient(90deg,var(--purple),var(--purple-light));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;}
.hero-bottom{display:grid;grid-template-columns:1fr auto;gap:40px;align-items:end;margin-top:48px;padding-top:32px;border-top:1px solid var(--line);}
.hero-desc{font-size:.75rem;line-height:2;color:var(--dim);max-width:440px;}
.hero-desc strong{color:var(--white);}
.hero-actions{display:flex;flex-direction:column;gap:12px;align-items:flex-end;}
.btn-purple{display:inline-flex;align-items:center;gap:12px;background:var(--purple);color:var(--white);font-family:'Syne',sans-serif;font-size:.6rem;letter-spacing:.2em;text-transform:uppercase;text-decoration:none;padding:13px 24px;transition:all .3s;cursor:none;}
.btn-purple:hover{background:var(--purple-light);}
.btn-outline-purple{display:inline-flex;align-items:center;gap:12px;border:1px solid var(--line-purple);color:var(--purple-light);font-size:.6rem;letter-spacing:.2em;text-transform:uppercase;text-decoration:none;padding:13px 24px;transition:all .3s;cursor:none;}
.btn-outline-purple:hover{border-color:var(--purple);color:var(--purple);}

/* TICKER */
.ticker-wrap{overflow:hidden;border-top:1px solid var(--line-purple);border-bottom:1px solid var(--line-purple);padding:12px 0;background:var(--purple-faint);}
.ticker{display:flex;width:max-content;animation:ticker 22s linear infinite;}
.tick-item{font-family:'Space Mono',monospace;font-size:.58rem;letter-spacing:.1em;color:var(--purple-light);white-space:nowrap;padding:0 28px;display:flex;align-items:center;gap:28px;}
.tick-item::after{content:'//';font-size:.45rem;color:var(--purple-dim);}
@keyframes ticker{from{transform:translateX(0);}to{transform:translateX(-50%);}}

/* ABOUT STRIP */
.about-strip{padding:72px 48px;display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center;border-bottom:1px solid var(--line);}
.as-mono{font-family:'Space Mono',monospace;font-size:.62rem;color:var(--purple);letter-spacing:.06em;margin-bottom:20px;}
.as-h{font-size:clamp(1.8rem,3.5vw,2.8rem);font-weight:800;text-transform:uppercase;letter-spacing:-.02em;line-height:1;margin-bottom:20px;}
.as-h em{font-style:normal;background:linear-gradient(90deg,var(--purple),var(--purple-light));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;}
.as-body{font-size:.73rem;line-height:2;color:var(--dim);}
.as-pills{display:flex;flex-direction:column;gap:1px;background:var(--line);}
.as-pill{background:var(--bg2);padding:16px 20px;display:flex;justify-content:space-between;align-items:center;transition:background .3s;}
.as-pill:hover{background:var(--surface);}
.as-pill-l{display:flex;align-items:center;gap:14px;}
.as-pill-code{font-family:'Space Mono',monospace;font-size:.65rem;color:var(--purple);min-width:36px;}
.as-pill-text{font-size:.68rem;color:var(--white);}
.as-pill-r{font-size:.58rem;letter-spacing:.12em;text-transform:uppercase;color:var(--dim);}

/* GRID */
.work-section{padding:0;}
.work-head{padding:40px 48px 32px;display:flex;justify-content:space-between;align-items:end;border-bottom:1px solid var(--line);}
.work-title{font-size:clamp(2rem,4vw,3.2rem);font-weight:800;text-transform:uppercase;letter-spacing:-.02em;line-height:.95;}
.work-mono{font-family:'Space Mono',monospace;font-size:.62rem;color:var(--purple);display:block;margin-bottom:10px;}
.work-tabs{display:flex;}
.wtab{font-size:.58rem;letter-spacing:.18em;text-transform:uppercase;color:var(--dim);background:none;border:1px solid var(--line);padding:9px 18px;cursor:pointer;transition:all .3s;font-family:'Syne',sans-serif;margin-left:-1px;}
.wtab.active,.wtab:hover{background:var(--purple);color:var(--white);border-color:var(--purple);}

.port-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);}
.card{position:relative;overflow:hidden;background:var(--bg);cursor:pointer;}
.card-media{width:100%;overflow:hidden;position:relative;}
.card-fill{width:100%;height:100%;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:12px;transition:transform .7s cubic-bezier(.25,.46,.45,.94);}
.card:hover .card-fill{transform:scale(1.04);}

/* Editorial frame */
.card-frame{position:absolute;inset:12px;border:1px solid rgba(139,92,246,0.12);pointer-events:none;z-index:1;}

.cf1{background:linear-gradient(160deg,#0c0818 0%,#080510 100%);}
.cf2{background:linear-gradient(160deg,#08080e 0%,#050508 100%);}
.cf3{background:linear-gradient(160deg,#0a0814 0%,#06060e 100%);}
.cf4{background:linear-gradient(160deg,#080c10 0%,#050810 100%);}
.cf5{background:linear-gradient(160deg,#0c0a18 0%,#080614 100%);}

.card-overlay{position:absolute;inset:0;background:linear-gradient(to top,rgba(5,5,7,.95) 0%,rgba(5,5,7,.1) 55%,transparent 100%);opacity:0;transition:opacity .4s;display:flex;flex-direction:column;justify-content:flex-end;padding:20px;z-index:2;}
.card:hover .card-overlay{opacity:1;}
.card-cat{font-family:'Space Mono',monospace;font-size:.5rem;color:var(--purple-light);letter-spacing:.08em;margin-bottom:5px;}
.card-title{font-size:.9rem;font-weight:700;text-transform:uppercase;letter-spacing:.03em;color:var(--white);line-height:1.2;}
.card-tag{position:absolute;top:12px;left:12px;font-family:'Space Mono',monospace;font-size:.48rem;color:var(--dim);border:1px solid var(--line);padding:3px 8px;z-index:3;backdrop-filter:blur(4px);background:rgba(5,5,7,.4);}
.card-tag.video{color:var(--purple-light);border-color:var(--line-purple);}
.play-btn{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:36px;height:36px;border:1px solid var(--line-purple);display:flex;align-items:center;justify-content:center;font-size:.6rem;color:var(--purple-light);opacity:0;transition:opacity .3s;z-index:3;backdrop-filter:blur(4px);background:rgba(5,5,7,.4);}
.card:hover .play-btn{opacity:1;}

/* PACKAGES */
.packages{padding:72px 48px;border-top:1px solid var(--line);}
.sec-mono{font-family:'Space Mono',monospace;font-size:.62rem;color:var(--purple);letter-spacing:.06em;margin-bottom:28px;}
.pkg-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line);}
.pkg{background:var(--bg2);padding:32px 24px;position:relative;transition:background .3s;}
.pkg:hover{background:var(--surface);}
.pkg-featured{background:var(--surface2);border-top:2px solid var(--purple);}
.pkg-featured-tag{position:absolute;top:-1px;left:50%;transform:translateX(-50%);font-family:'Space Mono',monospace;font-size:.45rem;letter-spacing:.15em;text-transform:uppercase;color:var(--purple);background:var(--bg);padding:3px 10px;white-space:nowrap;}
.pkg-label{font-family:'Space Mono',monospace;font-size:.52rem;color:var(--purple);letter-spacing:.08em;margin-bottom:10px;margin-top:16px;}
.pkg:not(.pkg-featured) .pkg-label{margin-top:0;}
.pkg-name{font-size:1rem;font-weight:700;color:var(--white);margin-bottom:14px;text-transform:uppercase;letter-spacing:.02em;}
.pkg-items{list-style:none;display:flex;flex-direction:column;gap:7px;}
.pkg-items li{font-size:.62rem;color:var(--dim);display:flex;gap:8px;line-height:1.6;}
.pkg-items li::before{content:'—';color:var(--purple-dim);flex-shrink:0;}

.pkg-custom{background:var(--surface);border:1px solid var(--line-purple);padding:28px 32px;margin-top:1px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:20px;}
.pkg-custom h3{font-size:.85rem;font-weight:600;color:var(--white);margin-bottom:6px;text-transform:uppercase;letter-spacing:.03em;}
.pkg-custom p{font-size:.65rem;color:var(--dim);line-height:1.7;max-width:460px;}

.addons-btn{width:100%;background:var(--bg2);border:none;border-top:1px solid var(--purple);padding:18px 24px;display:flex;justify-content:space-between;align-items:center;cursor:pointer;margin-top:1px;font-family:'Syne',sans-serif;transition:background .3s;}
.addons-btn:hover{background:var(--surface);}
.addons-btn-l{display:flex;align-items:center;gap:16px;}
.addons-lbl{font-family:'Space Mono',monospace;font-size:.6rem;color:var(--purple);letter-spacing:.06em;}
.addons-sub{font-size:.62rem;color:var(--dim);}
.addons-plus{font-size:1.3rem;color:var(--purple);transition:transform .3s;}
.addons-plus.open{transform:rotate(45deg);}
.addons-grid{display:none;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);margin-top:1px;}
.addons-grid.open{display:grid;}
.addon{background:var(--bg2);padding:24px 22px;transition:background .3s;}
.addon:hover{background:var(--surface);}
.addon-plus{font-family:'Space Mono',monospace;font-size:.9rem;color:var(--purple);margin-bottom:10px;}
.addon-title{font-size:.78rem;font-weight:600;color:var(--white);margin-bottom:8px;text-transform:uppercase;letter-spacing:.02em;}
.addon-body{font-size:.62rem;color:var(--dim);line-height:1.8;}
.pkg-note{font-family:'Space Mono',monospace;font-size:.58rem;color:rgba(242,240,248,.2);text-align:center;letter-spacing:.06em;margin-top:24px;}

/* PROCESS */
.process{padding:72px 48px;border-top:1px solid var(--line);background:var(--bg2);}
.proc-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line);margin-top:32px;}
.pstep{background:var(--bg2);padding:32px 24px;position:relative;overflow:hidden;transition:background .3s;}
.pstep:hover{background:var(--surface);}
.pstep::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,var(--purple),transparent);opacity:0;transition:opacity .3s;}
.pstep:hover::before{opacity:1;}
.pstep-num{font-family:'Space Mono',monospace;font-size:.62rem;color:var(--purple);margin-bottom:18px;}
.pstep-title{font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--white);margin-bottom:10px;}
.pstep-body{font-size:.65rem;line-height:1.9;color:var(--dim);}

/* PROOF STRIP */
.proof{background:var(--surface);padding:20px 48px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:16px;border-top:1px solid var(--line);}
.proof-item{font-family:'Space Mono',monospace;font-size:.56rem;color:rgba(242,240,248,.2);letter-spacing:.06em;}
.proof-avail{display:flex;align-items:center;gap:8px;}
.proof-dot{width:5px;height:5px;border-radius:50%;background:#7BC67E;box-shadow:0 0 6px rgba(123,198,126,.5);animation:pulse 2s ease-in-out infinite;}

/* CONTACT */
.contact{padding:100px 48px;position:relative;overflow:hidden;display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center;border-top:1px solid var(--line);}
.contact-bg{position:absolute;inset:0;background:radial-gradient(ellipse 60% 60% at 30% 50%,var(--purple-faint) 0%,transparent 70%);pointer-events:none;}
.contact-l{position:relative;z-index:1;}
.contact-mono{font-family:'Space Mono',monospace;font-size:.62rem;color:var(--purple);letter-spacing:.06em;margin-bottom:20px;}
.contact-h{font-size:clamp(2.5rem,5.5vw,4.5rem);font-weight:800;text-transform:uppercase;letter-spacing:-.03em;line-height:.9;margin-bottom:24px;}
.contact-h em{display:block;background:linear-gradient(90deg,var(--purple),var(--purple-light));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;font-style:normal;}
.contact-sub{font-size:.72rem;line-height:2;color:var(--dim);}
.contact-r{position:relative;z-index:1;display:flex;flex-direction:column;gap:16px;}
.contact-email{font-size:1.2rem;font-weight:600;color:var(--white);text-decoration:none;border-bottom:1px solid var(--line-purple);padding-bottom:14px;transition:all .3s;display:block;}
.contact-email:hover{color:var(--purple-light);border-color:var(--purple);}
.contact-ig{font-size:.65rem;letter-spacing:.1em;color:var(--dim);text-decoration:none;display:flex;align-items:center;gap:8px;transition:color .3s;}
.contact-ig:hover{color:var(--purple-light);}
.contact-info{display:flex;flex-wrap:wrap;gap:10px;margin-top:8px;}
.cinfo{font-family:'Space Mono',monospace;font-size:.55rem;color:rgba(242,240,248,.2);display:flex;align-items:center;gap:6px;letter-spacing:.04em;}

/* FOOTER */
footer{padding:20px 48px;border-top:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;background:var(--bg);}
.foot-mono{font-family:'Space Mono',monospace;font-size:.58rem;color:rgba(242,240,248,.15);}
.foot-mid{font-family:'Space Mono',monospace;font-size:.56rem;color:var(--purple);letter-spacing:.06em;opacity:.5;}
.foot-link{font-size:.58rem;letter-spacing:.15em;text-transform:uppercase;color:rgba(242,240,248,.2);text-decoration:none;transition:color .3s;}
.foot-link:hover{color:var(--purple-light);}

/* REVEAL */
.reveal{opacity:0;transform:translateY(20px);transition:opacity .9s cubic-bezier(.25,.46,.45,.94),transform .9s cubic-bezier(.25,.46,.45,.94);}
.reveal.in{opacity:1;transform:translateY(0);}

/* MOBILE */
@media(max-width:860px){
  nav{padding:16px 20px;}
  .nav-links{display:none;}
  .hero{padding:0 20px 48px;}
  .hero-corner{display:none;}
  .hero-bottom{grid-template-columns:1fr;}
  .hero-actions{align-items:flex-start;}
  .about-strip{grid-template-columns:1fr;padding:56px 20px;}
  .work-head{padding:28px 20px;flex-direction:column;align-items:flex-start;gap:20px;}
  .port-grid{grid-template-columns:1fr 1fr;}
  .packages{padding:56px 20px;}
  .pkg-grid{grid-template-columns:1fr 1fr;}
  .addons-grid{grid-template-columns:1fr 1fr;}
  .process{padding:56px 20px;}
  .proc-grid{grid-template-columns:1fr 1fr;}
  .contact{grid-template-columns:1fr;padding:56px 20px;}
  .proof{padding:16px 20px;}
  footer{flex-direction:column;gap:10px;text-align:center;padding:20px;}
  body{cursor:auto;}
  .cur,.cur-ring{display:none;}
}
</style>
</head>
<body>

<div class="cur" id="cur"></div>
<div class="cur-ring" id="ring"></div>

<nav>
  <span class="nav-mono">// Joy.UGC</span>
