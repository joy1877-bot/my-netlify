    <div class="as-pill"><div class="as-pill-l"><span class="as-pill-code">[DE]</span><span class="as-pill-text">Deutsch — native quality</span></div><span class="as-pill-r">DACH markets</span></div>
    <div class="as-pill"><div class="as-pill-l"><span class="as-pill-code">[EN]</span><span class="as-pill-text">English — fluent</span></div><span class="as-pill-r">Global reach</span></div>
