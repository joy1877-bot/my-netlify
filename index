</section>

<!-- TICKER -->
<div class="ticker-wrap">
  <div class="ticker">
    <span class="tick-item">Tech UGC</span><span class="tick-item">Product Reviews</span><span class="tick-item">App Demos</span><span class="tick-item">Unboxing</span><span class="tick-item">Lifestyle Products</span><span class="tick-item">Reels & TikTok</span><span class="tick-item">German + English</span><span class="tick-item">Austria → Global</span>
